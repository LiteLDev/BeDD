<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BeDD.exe: started without arguments it opens the manager window (Gui/); with arguments it is the
    command line (Cli/), "BeDD.exe <noun> <verb> [arguments] [flags]". A GUI-subsystem program that
    attaches to the caller's console for the command line, like LeviLauncher.exe.
    NativeAOT: no reflection-based JSON (each unit adds a source-generated JsonSerializerContext),
    Win32 through CsWin32 (NativeMethods.txt).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BeDD</AssemblyName>
    <RootNamespace>BeDD</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.0.0</Version>
    <Product>Be.D.D.</Product>
    <Description>Run end-to-end tests of LeviLamina client mods in background Minecraft games.</Description>
    <ApplicationIcon>BeDD.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BeDD.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
